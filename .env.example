# ==========================================================
# ENVIRONNEMENT POKÉVINTED - EXEMPLE DE CONFIGURATION
# Copiez ce fichier vers .env et personnalisez les secrets avant déploiement :
# cp .env.example .env
# ==========================================================

# Mode d'exécution
ENVIRONMENT=production
DEBUG=false

# Ports d'écoute sur la machine hôte
APP_PORT=3000
GRAFANA_PORT=3001

# MONGODB (Authentification obligatoire en production)
MONGO_ROOT_USER=admin_pokevinted
MONGO_ROOT_PASSWORD=ChangeMe_P0k3V1nt3d_M0ng0_P@ssw0rd!
MONGO_DB=pokevinted
MONGO_URI=mongodb://admin_pokevinted:ChangeMe_P0k3V1nt3d_M0ng0_P@ssw0rd!@mongodb:27017/pokevinted?authSource=admin

# REDIS (Authentification requirepass obligatoire en production)
REDIS_PASSWORD=ChangeMe_P0k3V1nt3d_R3d1s_T0k3n!
REDIS_URL=redis://:ChangeMe_P0k3V1nt3d_R3d1s_T0k3n!@redis:6379/0

# ELASTICSEARCH (Isolé sur le réseau interne Docker)
ELASTICSEARCH_HOST=http://elasticsearch:9200

# GRAFANA (Identifiants d'administration)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=ChangeMe_Grafana_Admin_Password!

# CORS
CORS_ORIGINS=*
