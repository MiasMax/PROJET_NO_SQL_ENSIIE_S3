# ==========================================================
# PokéVinted environment configuration template
# Copy to .env and configure secrets before deployment:
# cp .env.example .env
# ==========================================================

# Execution mode
ENVIRONMENT=production
DEBUG=false

# Host exposed port bindings & Interface
# BIND_IP: interface for the frontend and Grafana. Defaults to 127.0.0.1 (loopback only).
# Set to 0.0.0.0 only on a VPS/LAN host that must be reachable remotely (behind a firewall).
# The backend API always stays on loopback: the frontend reaches it through nginx (/api).
BIND_IP=127.0.0.1
APP_PORT=3000
BACKEND_PORT=8000
GRAFANA_PORT=3001

# MONGODB (Authentication enabled)
MONGO_ROOT_USER=admin_pokevinted
MONGO_ROOT_PASSWORD=ChangeMe_P0k3V1nt3d_M0ng0_P@ssw0rd!
MONGO_DB=pokevinted
# Note: '@' in the password MUST be percent-encoded as %40 inside the URI (RFC 3986).
MONGO_URI=mongodb://admin_pokevinted:ChangeMe_P0k3V1nt3d_M0ng0_P%40ssw0rd!@mongodb:27017/pokevinted?authSource=admin

# REDIS (Password authentication enabled)
REDIS_PASSWORD=ChangeMe_P0k3V1nt3d_R3d1s_T0k3n!
REDIS_URL=redis://:ChangeMe_P0k3V1nt3d_R3d1s_T0k3n!@redis:6379/0

# ELASTICSEARCH (Isolated in internal Docker network)
ELASTICSEARCH_HOST=http://elasticsearch:9200

# GRAFANA (Administrator credentials)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=ChangeMe_Grafana_Admin_Password!

# CORS — allow-list of frontend origins (comma-separated). Avoid "*": it disables
# credentialed requests and exposes the API to any site. Add your production
# domain here when deploying (e.g. https://pokevinted.example.com).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
